# Copy this file to .env.local and fill in the values from your Supabase project
# (supabase.com → your project → Settings → API)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-side only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the deployed site (used for SEO metadata and QR links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
